<%- include('cabecalho.ejs')%>
    <main>
        <section class="page-section container">
            <link rel="stylesheet" href="/css/site.css">

            <div class="page-intro">
                <p class="eyebrow">LEITURAS DA COMUNIDADE</p>
                <h1>Livros por avaliação</h1>
                <p>Descubra os livros organizados de acordo com a avaliação dos leitores.</p>
            </div>

            <% for (const nota of [5, 4, 3, 2, 1]) { %>

                <section class="rating-row">

                    <div class="rating-row-heading">
                        <h2>
                            <%= nota %>
                                <%= nota==1 ? 'estrela' : 'estrelas' %>
                        </h2>

                        <div class="stars stars-small" aria-label="<%= nota %> de 5 estrelas">

                            <% for (let i=1; i <=5; i++) { %>

                                <span class="star <%= i <= nota ? 'active' : '' %>">★</span>

                                <% } %>

                        </div>
                    </div>

                    <div class="book-grid compact-grid">

                        <% let encontrou=false; %>

                            <% for (const {id, titulo, fotoLivro, genero, autor, avaliacao} of livros) { %>

                                <% if ((avaliacao || 5)==nota) { %>

                                    <% encontrou=true; %>

                                        <article class="book-card">

                                            <div class="cover-wrap">

                                                <a class="cover-button" href="/site/livro-detalhe"
                                                    aria-label="Ver detalhes de <%= titulo %>">

                                                    <img src="<%= fotoLivro %>" alt="Capa de <%= titulo %>"
                                                        class="book-cover">

                                                </a>

                                                <input class="favorite-toggle" type="checkbox"
                                                    id="fav-rating-<%= nota %>-<%= id %>">

                                                <label class="heart-button" for="fav-rating-<%= nota %>-<%= id %>"
                                                    aria-label="Favoritar <%= titulo %>">

                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                                        stroke-linejoin="round" aria-hidden="true">

                                                        <path
                                                            d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z">
                                                        </path>

                                                    </svg>

                                                </label>

                                                <span class="availability available">Disponível</span>

                                            </div>

                                            <div class="book-copy">

                                                <p class="eyebrow">
                                                    <%= genero.nome %>
                                                </p>

                                                <a class="book-title" href="/site/livro-detalhe">
                                                    <%= titulo %>
                                                </a>

                                                <p class="book-author">
                                                    <%= autor.nome %>
                                                </p>

                                                <div class="stars stars-small" aria-label="<%= nota %> de 5 estrelas">

                                                    <% for (let i=1; i <=5; i++) { %>

                                                        <span class="star <%= i <= nota ? 'active' : '' %>">★</span>

                                                        <% } %>

                                                </div>

                                            </div>

                                        </article>

                                        <% } %>

                                            <% } %>

                                                <% if (!encontrou) { %>

                                                    <p class="muted">
                                                        Ainda não há livros nesta avaliação.
                                                    </p>

                                                    <% } %>

                    </div>

                </section>

                <% } %>

        </section>
    </main>

    <%- include('rodape.ejs')%>
        </body>

        </html>