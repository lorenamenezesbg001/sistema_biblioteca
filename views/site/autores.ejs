<%- include('cabecalho.ejs')%>
    <main>
        <section class="page-section container">
            <link rel="stylesheet" href="/css/site.css">
            <div class="page-intro">
                <p class="eyebrow">VOZES E HISTÓRIAS</p>
                <h1>Conheça nossos autores</h1>
                <p>Pessoas, lugares e trajetórias por trás dos livros do nosso acervo.</p>
            </div>

            <div class="author-grid">

                <% for (const {nome, localNascimento, fotoAutor} of autores) { %>

                    <article class="author-card">
                        <div class="author-portrait portrait-1">

                            <% if (fotoAutor) { %>
                                <img src="<%= fotoAutor %>" alt="Foto de <%= nome %>"
                                    style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <span>
                                        <%= nome.substring(0, 2).toUpperCase() %>
                                    </span>
                                    <% } %>

                        </div>
                        <div>
                            <p class="eyebrow">AUTOR</p>
                            <h2>
                                <%= nome %>
                            </h2>
                            <p>Natural de <%= localNascimento %>
                            </p>
                            <a href="/site/acervo">Ver livros <svg width="17" height="17" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                    stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"></path>
                                    <path d="m14 7 5 5-5 5"></path>
                                </svg></a>
                        </div>
                    </article>

                    <% } %>

            </div>
        </section>
    </main>
    <%- include('rodape.ejs')%>
        </body>

        </html>