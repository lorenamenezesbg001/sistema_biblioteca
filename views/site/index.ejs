<%- include('cabecalho.ejs') %>

    <link rel="stylesheet" href="/css/site.css">

    <main>

        <!-- BANNER PRINCIPAL -->
        <section class="hero">

            <div class="hero-image" role="img" aria-label="Estantes de madeira repletas de livros">
            </div>

            <div class="container hero-content">

                <div class="hero-copy">

                    <p class="hero-kicker">LEITURAS QUE ACOLHEM</p>

                    <h1>
                        Histórias para<br>
                        <em>todos os capítulos.</em>
                    </h1>

                    <p>
                        Explore nosso acervo, descubra novos mundos
                        e encontre o seu próximo livro favorito.
                    </p>

                    <form class="hero-search" action="/site/acervo" method="GET">

                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m20 20-4-4"></path>

                        </svg>

                        <input name="busca" placeholder="Busque por título, autor, gênero ou editora"
                            aria-label="Pesquisar no acervo">

                        <button type="submit">Buscar</button>

                    </form>

                </div>

            </div>

        </section>


        <!-- LIVROS EM DESTAQUE -->
        <section class="section container">

            <div class="section-heading">

                <div>

                    <p class="eyebrow">ESCOLHAS DA SEMANA</p>

                    <h2>Descubra novas histórias</h2>

                </div>

                <a class="text-link" href="/site/acervo">

                    Ver todo o acervo

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                        <path d="M5 12h14"></path>
                        <path d="m14 7 5 5-5 5"></path>

                    </svg>

                </a>

            </div>


            <div class="book-grid featured-grid">

                <% if (livros && livros.length> 0) { %>

                    <% for (const livro of livros) { %>

                        <article class="book-card">

                            <div class="cover-wrap">

                                <a class="cover-button" href="/site/livro-detalhe">

                                    <img src="<%= livro.fotoLivro || '/img/livro-sem-capa.png' %>"
                                        alt="Capa de <%= livro.titulo %>" class="book-cover">

                                </a>


                                <input class="favorite-toggle" type="checkbox" id="fav-catalog-<%= livro._id %>">

                                <label class="heart-button" for="fav-catalog-<%= livro._id %>"
                                    aria-label="Favoritar <%= livro.titulo %>">

                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                        aria-hidden="true">

                                        <path
                                            d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z">
                                        </path>

                                    </svg>

                                </label>


                                <span class="availability available">
                                    Disponível
                                </span>

                            </div>


                            <div class="book-copy">

                                <p class="eyebrow">

                                    <%= livro.genero && livro.genero.nome ? livro.genero.nome : 'Sem gênero' %>

                                </p>


                                <a class="book-title" href="/site/livro-detalhe">

                                    <%= livro.titulo %>

                                </a>


                                <p class="book-author">

                                    <%= livro.autor && livro.autor.nome ? livro.autor.nome : 'Autor desconhecido' %>

                                </p>


                                <div class="stars stars-small" aria-label="5 de 5 estrelas">

                                    <span class="star active">★</span>
                                    <span class="star active">★</span>
                                    <span class="star active">★</span>
                                    <span class="star active">★</span>
                                    <span class="star active">★</span>

                                </div>

                            </div>

                        </article>

                        <% } %>

                            <% } else { %>

                                <p class="empty-message">
                                    Nenhum livro cadastrado no momento.
                                </p>

                                <% } %>

            </div>

        </section>


        <!-- FRASE INSPIRADORA -->
        <section class="quote-band">

            <div class="container quote-inner">

                <span class="quote-mark">“</span>

                <blockquote>
                    Um livro é um sonho que você segura nas mãos.
                </blockquote>

                <span class="quote-author">
                    — Neil Gaiman
                </span>

            </div>

        </section>


        <!-- CATEGORIAS -->
        <section class="section container categories-section">

            <div class="section-heading">

                <div>

                    <p class="eyebrow">ENCONTRE SEU CAMINHO</p>

                    <h2>Explore por gênero</h2>

                </div>

            </div>


            <div class="category-grid">

                <a class="category-card" href="/site/acervo?genero=Romance">

                    <span>01</span>
                    <strong>Romance</strong>
                    <small>42 títulos</small>

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                        <path d="M5 12h14"></path>
                        <path d="m14 7 5 5-5 5"></path>

                    </svg>

                </a>


                <a class="category-card" href="/site/acervo?genero=Clássicos">

                    <span>02</span>
                    <strong>Clássicos</strong>
                    <small>35 títulos</small>

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                        <path d="M5 12h14"></path>
                        <path d="m14 7 5 5-5 5"></path>

                    </svg>

                </a>


                <a class="category-card" href="/site/acervo?genero=Poesia">

                    <span>03</span>
                    <strong>Poesia</strong>
                    <small>28 títulos</small>

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                        <path d="M5 12h14"></path>
                        <path d="m14 7 5 5-5 5"></path>

                    </svg>

                </a>


                <a class="category-card" href="/site/acervo?genero=Mistério">

                    <span>04</span>
                    <strong>Mistério</strong>
                    <small>31 títulos</small>

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

                        <path d="M5 12h14"></path>
                        <path d="m14 7 5 5-5 5"></path>

                    </svg>

                </a>

            </div>

        </section>

    </main>

    <%- include('rodape.ejs') %>