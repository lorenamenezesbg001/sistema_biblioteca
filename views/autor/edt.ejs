<%- include('../cabecalho.ejs')%>
    <h1>Editar Autor</h1>
    <div>
        <a href="/autor/lst">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="<%= Autor._id %>"><br>
            <label>Nome:</label>
            <input type="text" name="nome" value="<%= Autor.nome %>"><br>
            <label>Local Nascimento:</label>
            <input type="text" name="localNascimento" value="<%= Autor.localNascimento %>"><br>
            <label>Foto:</label>
            <% if (Autor.fotoAutor) { %>
                <img src="<%= Autor.fotoAutor %>" width="100" height="100"><br>
                <% } %>
                    <input type="file" name="fotoAutor"><br>
                    <button type="submit">Cadastrar</button>
        </form>
    </div>

    <%- include('../rodape.ejs')%>