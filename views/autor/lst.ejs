<%- include('../cabecalho.ejs')%>
    <h1>Autores</h1>
    <div>
        <form action="/autor/lst" method="post">
            <input type="text" name="filtro" id="" placeholder="Digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/autor/add">+ Autor</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Local de Nascimento</td>
            <td>Foto</td>
            <td>Ações</td>
        </tr>

        <% for (const autor of Autores) { %>
            <tr>
                <td>
                    <%= autor.nome %>
                </td>
                <td>
                    <%= autor.localNascimento %>
                </td>
                <td>
                    <% if (autor.fotoAutor) { %>
                        <img src="<%= autor.fotoAutor%>" width="100" height="100" alt="Foto do autor">
                        <% } else { %>
                            Sem foto
                            <% } %>
                </td>
                <td>
                    <a href="/autor/edt/<%= autor._id %>">Editar</a>
                    <a href="/autor/del/<%= autor._id %>">Excluir</a>
                </td>
            </tr>
            <% } %>
    </table>
    <%- include('../rodape.ejs')%>