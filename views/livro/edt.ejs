<%- include('../cabecalho.ejs')%>
    <h1>Editar Livro</h1>
    <div>
        <a href="/livro/lst">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="<%= Livro._id %>"><br>
            <label>Título:</label>
            <input type="text" name="titulo" value="<%= Livro.titulo %>"><br>
            <label>Descrição:</label>
            <input type="text" name="descricao" value="<%= Livro.descricao %>"><br>
            <label>Ano de publicação:</label>
            <input type="text" name="anoPublicacao" value="<%= Livro.anoPublicacao %>"><br>
            <label>Foto:</label>
            <% if (Livro.fotoLivro) { %>
                <img src="<%= Livro.fotoLivro %>" width="100" height="100"><br>
                <% } %>
                    <select name="genero" id="genero" class="form-control">
                        <option value="">selecione</option>
                        <%Generos.forEach(function(genero){%>
                            <option value='<%=genero.id%>'>
                                <%=genero.nome%>
                            </option>
                            <%})%>
                    </select>
                    <input type="file" name="fotoLivro"><br>
                    <button type="submit">Cadastrar</button>
        </form>
    </div>

    <%- include('../rodape.ejs')%>