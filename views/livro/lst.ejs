<%- include('../cabecalho.ejs')%>
    <h1>Livros</h1>
    <div>
        <form action="/livro/lst" method="post">
            <input type="text" name="filtro" id="" placeholder="Digite o nome do livro">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/livro/add">+ Novo Livro</a>
    <table>
        <tr>
            <td>Título</td>
            <td>Descrição</td>
            <td>Ano de publicação</td>
            <td>Foto</td>
            <td>Gênero</td>
            <td>Autor</td>
            <td>Editora</td>
            <td>Ações</td>
        </tr>

        <% for (const {id, titulo, descricao, anoPublicacao, fotoLivro, genero, autor, editora} of Livros) { %>
            <tr>
                <td>
                    <%= titulo %>
                </td>
                <td>
                    <%= descricao %>
                </td>
                <td>
                    <%= anoPublicacao %>
                </td>
                <td>
                    <% if (fotoLivro) { %>
                        <img src="<%=fotoLivro%>" width="100" height="100" alt="Foto do livro">
                        <% } else { %>
                            Sem foto
                            <% } %>
                </td>
                <td>
                    <%=genero !=null ? genero.nome : "" %>
                </td>
                <td>
                    <%=autor !=null ? autor.nome : "" %>
                </td>
                <td>
                    <%=editora !=null ? editora.nome : "" %>
                </td>
                <td>
                    <a href="/livro/edt/<%= id %>">Editar</a>
                    <a href="/livro/del/<%= id %>">Excluir</a>
                </td>
            </tr>
            <% } %>
    </table>
    <%- include('../rodape.ejs')%>